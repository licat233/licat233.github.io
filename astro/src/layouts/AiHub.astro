---
import BaseLayout from './BaseLayout.astro';
import GlassSurface from '../components/GlassSurface.astro';
import { localeUrl, type Lang } from '../lib/site';
import { dictionary } from '../lib/translation';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t=dictionary(lang).aiHub;
const title=t.title;
const description=t.description;
const cards=[
 {key:'skills',name:'Agent Skills',href:localeUrl(lang,'skills')},
 {key:'prompts',name:'Prompts',href:localeUrl(lang,'prompts')},
 {key:'toolscout',name:'MCP · ToolScout',href:lang==='zh'?'/toolscout/zh/':'/toolscout/en/'},
 {key:'eao',name:'Agents · Enterprise AI Office',href:lang==='zh'?'/eao/':'/eao/en/'},
 {key:'memory',name:'Memory · armor-memory',href:lang==='zh'?'/armor-memory/zh/':'/armor-memory/'}
] as const;
const styles = [
  '/assets/vendor/open-props/open-props-core-1.7.23.min.css',
  '/assets/portfolio.css?v=20261008-glass1',
  '/assets/site-header.css?v=20261028-ai-glass1',
  '/assets/portfolio-liquid-glass.css?v=20261028-ai-active-group1',
  '/assets/site-sections.css?v=20261027-ia1'
];
---
<BaseLayout {lang} active="ai" {title} {description}
  canonical={localeUrl(lang,'ai')}
  zhHref={localeUrl('zh','ai')} enHref={localeUrl('en','ai')} {styles} pageClass="site-section-page">
  <main id="content" class="site-section-main">
    <div class="shell">
      <p class="site-section-kicker">REUSABLE AI PRACTICE</p>
      <h1>{title}</h1>
      <p class="site-section-lead">{t.lead}</p>
      <p class="site-section-meta">{t.meta}</p>
      <div class="site-section-grid" aria-label={t.aria}>
        {cards.map((card, i) => <GlassSurface as="a" class="site-section-card" material="regular"
          href={card.href}>
          <span class="site-section-card__index">{String(i + 1).padStart(2, '0')}</span>
          <h2>{card.name}</h2>
          <p>{t.cards[card.key]}</p>
          <span class="site-section-card__go">{t.explore} ↗</span>
        </GlassSurface>)}
      </div>
      <p class="site-section-footer-link"><a href={localeUrl(lang,'home')}>
        {t.back}</a></p>
    </div>
  </main>
</BaseLayout>
