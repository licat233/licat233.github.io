---
import SiteHeader from '../components/SiteHeader.astro';
import type { Lang, NavKey } from '../lib/site';
interface Props {
  lang: Lang; active: NavKey; title: string; description: string;
  canonical: string; zhHref?: string; enHref?: string; pageClass?: string;
}
const {lang,active,title,description,canonical,zhHref,enHref,pageClass=''} = Astro.props;
const origin='https://licat233.github.io';
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="description" content={description} /><title>{title} · Licat</title>
<link rel="canonical" href={origin + canonical} />
<link rel="alternate" hreflang="zh-CN" href={origin + (zhHref || (lang === 'zh' ? canonical : '/'))} />
<link rel="alternate" hreflang="en" href={origin + (enHref || (lang === 'en' ? canonical : '/en/'))} />
<link rel="icon" href="/assets/licat-logo.svg" type="image/svg+xml" />
<script is:inline>(()=>{try{const s=localStorage.getItem('licat-theme');document.documentElement.dataset.theme=s==='dark'||s==='light'?s:(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light')}catch(_){document.documentElement.dataset.theme='light'}})();</script>
<link rel="stylesheet" href="/assets/vendor/open-props/open-props-core-1.7.23.min.css" />
<link rel="stylesheet" href="/assets/portfolio.css?v=20261008-glass1" />
<link rel="stylesheet" href="/assets/site-header.css?v=20261027-arch1" />
<link rel="stylesheet" href="/assets/portfolio-liquid-glass.css?v=20261010-perf1" />
<link rel="stylesheet" href="/assets/blog.css" />
<link rel="stylesheet" href="/assets/site-sections.css" />
</head>
<body class={pageClass}>
<SiteHeader {lang} {active} {zhHref} {enHref} />
<slot />
<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" aria-hidden="true" style="position:absolute;overflow:hidden"><filter id="portfolioLensFilter" x="-6%" y="-15%" width="112%" height="130%" color-interpolation-filters="sRGB"><feGaussianBlur in="SourceAlpha" stdDeviation="12" result="edgeFade"/><feDisplacementMap in="SourceGraphic" in2="edgeFade" scale="12" xChannelSelector="A" yChannelSelector="A"/></filter></svg>
<script is:inline src="/assets/site-nav.js?v=20261027-arch1"></script>
</body>
</html>
