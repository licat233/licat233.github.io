---
import SiteHeader from '../components/SiteHeader.astro';
import { localeUrl, type Lang, type NavKey } from '../lib/site';
import { dictionary } from '../lib/translation';
interface Props {
  lang: Lang;
  active: NavKey;
  title: string;
  description: string;
  canonical: string;
  zhHref?: string;
  enHref?: string;
  pageClass?: string;
  alternateZh?: string | null;
  alternateEn?: string | null;
  exactTitle?: boolean;
  styles?: readonly string[];
  includeSiteNavScript?: boolean;
  includeLensFilter?: boolean;
  ogType?: 'website' | 'article';
}
const {
  lang, active, title, description, canonical, zhHref, enHref, pageClass = '',
  exactTitle = false,
  includeSiteNavScript = true,
  includeLensFilter = true,
  ogType = 'website',
} = Astro.props;
const defaultStyles = ['/assets/bundle-content.css?v=20261110-nav-bookmark-perf1'];
const styles = Astro.props.styles ?? defaultStyles;
const alternateZh = Astro.props.alternateZh !== undefined
  ? Astro.props.alternateZh : (zhHref || (lang === 'zh' ? canonical : null));
const alternateEn = Astro.props.alternateEn !== undefined
  ? Astro.props.alternateEn : (enHref || (lang === 'en' ? canonical : null));
const origin = 'https://licat.xyz';
const socialImage = origin + '/assets/licat-social.jpg';
const socialImageAlt = lang === 'en'
  ? 'Licat: a cat overlooking a mountain lake'
  : 'Licat 网站形象：猫咪眺望山间湖泊';
const labels = dictionary(lang).navigation;
const isSectionIndex = canonical === localeUrl(lang,active);
const breadcrumbItems = active === 'home' ? [] : [
  {name:lang === 'en' ? 'Home' : '首页',url:localeUrl(lang,'home')},
  ...(['skills','prompts'].includes(active) ? [{name:labels.ai,url:localeUrl(lang,'ai')}] : []),
  ...(active === 'blog' && !isSectionIndex ? [{name:labels.blog,url:localeUrl(lang,'blog')}] : []),
  ...(active === 'prompts' && !isSectionIndex ? [{name:labels.prompts,url:localeUrl(lang,'prompts')}] : []),
  {name:isSectionIndex ? labels[active] : title.replace(/ — Licat Prompts$/, ''),url:canonical},
];
const breadcrumbSchema = breadcrumbItems.length ? JSON.stringify({
  '@context':'https://schema.org','@type':'BreadcrumbList',
  itemListElement:breadcrumbItems.map((item,index)=>({
    '@type':'ListItem',position:index+1,name:item.name,item:origin+item.url,
  })),
}).replace(/</g,'\\u003c') : null;
const fullTitle = exactTitle ? title : `${title} · Licat`;
const homeSchema = active === 'home' ? JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': origin + '/#website',
      name: 'Licat',
      url: origin + '/',
      inLanguage: ['zh-CN', 'en'],
    },
    {
      '@type': 'Person',
      '@id': origin + '/#person',
      name: 'Licat',
      url: origin + '/',
      sameAs: ['https://github.com/licat233'],
    },
  ],
}).replace(/</g, '\\u003c') : null;
if (Astro.currentLocale !== lang) {
  throw new Error('Unexpected i18n locale for '+Astro.url.pathname+
    ': expected '+lang+', received '+Astro.currentLocale);
}
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
<head>
  <!-- Google Tag Manager -->
  <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-W68HGFLR');
  </script>
  <!-- End Google Tag Manager -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#f2f7fa" media="(prefers-color-scheme:light)" />
  <meta name="theme-color" content="#111416" media="(prefers-color-scheme:dark)" />
  <meta name="description" content={description} />
  <meta name="author" content="Licat" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={socialImage} />
  <meta name="twitter:image:alt" content={socialImageAlt} />
  <title>{fullTitle}</title>
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Licat" />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={origin + canonical} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={socialImageAlt} />
  <link rel="canonical" href={origin + canonical} />
  {alternateZh && <link rel="alternate" hreflang="zh-CN" href={origin + alternateZh} />}
  {alternateEn && <link rel="alternate" hreflang="en" href={origin + alternateEn} />}
  {active === 'home' && <link rel="alternate" hreflang="x-default" href={origin + '/'} />}
  <link rel="icon" href="/assets/licat-logo.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />
  <script is:inline>(()=>{try{const t=localStorage.getItem('licat-theme');document.documentElement.dataset.theme=t==='light'||t==='dark'?t:(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light')}catch(_){document.documentElement.dataset.theme='light'}})();</script>
  {styles.map(href => <link rel="stylesheet" href={href} />)}
  {homeSchema && <script type="application/ld+json" set:html={homeSchema}></script>}
  {breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema}></script>}

  <style is:global>
    .seo-breadcrumbs { width:min(1190px,calc(100% - 48px));margin:14px auto 0; color:var(--muted,var(--ink2,#6b7b85));font-size:12px;line-height:1.6 }
    .seo-breadcrumbs ol {display:flex;align-items:center;flex-wrap:wrap;gap:7px;list-style:none;padding:0;margin:0}
    .seo-breadcrumbs li {display:flex;align-items:center;gap:7px;min-width:0}
    .seo-breadcrumbs li+li::before {content:'›';opacity:.65}
    .seo-breadcrumbs a {color:inherit;text-decoration:none}
    .seo-breadcrumbs a:hover {color:var(--blue,#087ac2);text-decoration:underline;text-underline-offset:3px}
    .seo-breadcrumbs [aria-current='page'] {color:var(--text,#222);font-weight:650;overflow-wrap:anywhere}
    @media(max-width:650px){.seo-breadcrumbs{width:calc(100% - 36px);margin-top:10px}}
  </style>
  <slot name="head" />
</head>
<body class={pageClass}>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W68HGFLR" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <SiteHeader {lang} {active} {zhHref} {enHref} />
  {breadcrumbItems.length > 0 && (
    <nav class="seo-breadcrumbs" aria-label={lang === 'en' ? 'Breadcrumb' : '面包屑导航'}>
      <ol>
        {breadcrumbItems.map((item,index) => (
          <li>
            {index < breadcrumbItems.length - 1 ?
              <a href={item.url}>{item.name}</a> :
              <span aria-current="page">{item.name}</span>}
          </li>
        ))}
      </ol>
    </nav>
  )}
  <slot />
  {includeLensFilter && <svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" aria-hidden="true" style="position:absolute;overflow:hidden"><filter id="portfolioLensFilter" x="-6%" y="-15%" width="112%" height="130%" color-interpolation-filters="sRGB"><feGaussianBlur in="SourceAlpha" stdDeviation="12" result="edgeFade"/><feDisplacementMap in="SourceGraphic" in2="edgeFade" scale="12" xChannelSelector="A" yChannelSelector="A"/></filter></svg>}
  {includeSiteNavScript && <script is:inline src="/assets/site-nav.js?v=20261028-ai-active-group1"></script>}
</body>
</html>
