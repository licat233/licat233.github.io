---
import BaseLayout from './BaseLayout.astro';
import BlogFooter from '../components/BlogFooter.astro';
import { blogStyles } from '../lib/blog';
import { dictionary } from '../lib/translation';
import { getCollection } from 'astro:content';
import { blogSlug, localeUrl, localizedPath, type Lang } from '../lib/site';
interface Props {lang:Lang}
const {lang}=Astro.props;
const en=lang==='en';
const t=dictionary(lang).blog;
const posts=(await getCollection('blog', ({data})=>data.lang===lang)).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const date=(d:Date)=>new Intl.DateTimeFormat('en-CA',{year:'numeric',month:'2-digit',day:'2-digit',timeZone:'Asia/Taipei'}).format(d).replaceAll('-','.');
const title = en ? 'Digital Marketing & Operations Guides' : '数字营销与运营实战指南';
const desc = en
  ? 'Practical notes on SEO/GEO, overseas B2B social media operations, keyword research, GA4/GTM measurement, and digital workflows from Licat.'
  : 'Licat 分享 SEO/GEO、海外 B2B 社媒运营、关键词研究、GA4/GTM 转化追踪与数字化工作流的实战经验。';
const blogSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': 'https://licat.xyz' + localeUrl(lang, 'blog') + '#blog',
  name: title,
  url: 'https://licat.xyz' + localeUrl(lang, 'blog'),
  description: desc,
  inLanguage: en ? 'en' : 'zh-CN',
  author: { '@type': 'Person', '@id': 'https://licat.xyz/#person', name: 'Licat' },
}).replace(/</g, '\\u003c');
const intro=t.intro;
---
<BaseLayout {lang} active="blog" {title} description={desc} canonical={localeUrl(lang,'blog')} zhHref={localeUrl('zh','blog')} enHref={localeUrl('en','blog')} styles={blogStyles} pageClass="blog-page">
  <script slot="head" type="application/ld+json" set:html={blogSchema}></script>
<main id="content" class="blog-main">
 <section class="blog-intro" aria-labelledby="blog-heading">
 <div class="blog-eyebrow">LICAT / WRITING</div>
 <h1 id="blog-heading">{t.title}<span class="blog-title-dot">.</span></h1><p>{intro}</p>
 </section>
 <section class="blog-archive" aria-label={t.listLabel}>
 <div class="blog-archive-heading"><h2>{t.all}</h2><span>{posts.length} {t.unit}</span></div>
 <div class="blog-list">
 {posts.map(post=><article class="blog-list-item">
 <div class="blog-list-meta"><time datetime={post.data.date.toISOString().slice(0,10)}>{date(post.data.date)}</time></div>
 <h3><a href={localizedPath(lang,'blog',blogSlug(post.id))}>{post.data.title}</a></h3>
 {post.data.description && <p>{post.data.description}</p>}
 <a class="blog-read-link" href={localizedPath(lang,'blog',blogSlug(post.id))}>{t.read} ↗</a>
 </article>)}
 </div>
 </section>
</main>
<BlogFooter {lang} />
</BaseLayout>
