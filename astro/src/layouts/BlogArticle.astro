---
import BaseLayout from './BaseLayout.astro';
import BlogFooter from '../components/BlogFooter.astro';
import { blogStyles } from '../lib/blog';
import { dictionary } from '../lib/translation';
import type { CollectionEntry } from 'astro:content';
import { localeUrl, type Lang } from '../lib/site';

type TocHeading = { depth: number; slug: string; text: string };
type TocItem = { slug: string; text: string; children: TocHeading[] };
interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
  canonical: string;
  headings: TocHeading[];
}
const { post, lang, canonical, headings } = Astro.props;
const en = lang === 'en';
const t = dictionary(lang).blog;
const zhHref = en ? (post.data.translation_url || localeUrl('zh', 'blog')) : canonical;
const enHref = en ? canonical : (post.data.translation_url || localeUrl('en', 'blog'));
const hasTranslation = Boolean(post.data.translation_url);
// On untranslated posts, the language toggle can open the other archive,
// but hreflang must never claim that the archive is a translated article.
const alternateZh = hasTranslation ? zhHref : (en ? null : canonical);
const alternateEn = hasTranslation ? enHref : (en ? canonical : null);
const date = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Taipei',
}).format(post.data.date).replaceAll('-', '.');
const pageUrl = 'https://licat.xyz' + canonical;
const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': pageUrl + '#article',
  headline: post.data.title,
  image: 'https://licat.xyz/assets/licat-social.jpg',
  description: post.data.description || post.data.title,
  inLanguage: en ? 'en' : 'zh-CN',
  datePublished: post.data.date.toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  author: { '@type': 'Person', '@id': 'https://licat.xyz/#person', name: 'Licat', url: 'https://licat.xyz/' },
  publisher: { '@type': 'Person', '@id': 'https://licat.xyz/#person', name: 'Licat', url: 'https://licat.xyz/' },
}).replace(/</g, '\\u003c');

const tocHeadings = headings.filter(heading =>
  (heading.depth === 2 || heading.depth === 3) && heading.slug && heading.text.trim()
);
const tocItems: TocItem[] = [];
for (const heading of tocHeadings) {
  if (heading.depth === 2 || tocItems.length === 0) {
    tocItems.push({ slug: heading.slug, text: heading.text, children: [] });
  } else {
    tocItems[tocItems.length - 1].children.push(heading);
  }
}
const hasToc = tocHeadings.length > 1;
const tocLabel = en ? 'On this page' : '文章目录';
const tocCount = en ? tocItems.length + ' chapters' : tocItems.length + ' 个章节';
---

<BaseLayout {lang} active="blog" title={post.data.title} description={post.data.description || post.data.title} {canonical} {zhHref} {enHref} {alternateZh} {alternateEn} styles={blogStyles} ogType="article" pageClass="blog-page">
  <meta slot="head" property="article:published_time" content={post.data.date.toISOString()} />
  <script slot="head" type="application/ld+json" set:html={articleSchema}></script>
  <main id="content" class="blog-main">
    <div class="blog-article-layout">
      <article class="blog-article">
        <a class="blog-back" href={localeUrl(lang, 'blog')}>← {t.back}</a>
        <header class="blog-article-header">
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{date}</time>
          <h1>{post.data.title}</h1>
          {post.data.description && <p>{post.data.description}</p>}
        </header>

        {hasToc && (
          <details class="blog-toc-mobile">
            <summary>
              <span>{tocLabel}</span>
              <span class="blog-toc-mobile__count">{tocCount}</span>
            </summary>
            <nav aria-label={tocLabel}>
              <div class="blog-toc-toolbar">
                <button
                  class="blog-toc-global-toggle"
                  type="button"
                  data-blog-toc-global-toggle
                  data-expand-label={en ? 'Expand all' : '全部展开'}
                  data-collapse-label={en ? 'Collapse all' : '全部收起'}
                  aria-label={en ? 'Expand all' : '全部展开'}
                  aria-controls="blog-toc-list-mobile"
                >{en ? 'Expand all' : '全部展开'}</button>
              </div>
              <ol class="blog-toc-list" id="blog-toc-list-mobile">
                {tocItems.map(item => (
                  <li class="blog-toc-item" data-blog-toc-item={item.slug}>
                    <div class="blog-toc-item__row">
                      <a class="blog-toc-link blog-toc-link--chapter" href={'#' + item.slug} data-blog-toc-link={item.slug}>{item.text}</a>
                      {item.children.length > 0 && (
                        <button
                          class="blog-toc-toggle"
                          type="button"
                          aria-label={(en ? 'Expand section: ' : '展开章节：') + item.text}
                          aria-expanded="false"
                          aria-controls={'blog-toc-children-mobile-' + item.slug}
                          data-blog-toc-toggle={item.slug}
                          data-expand-label={en ? 'Expand section' : '展开章节'}
                          data-collapse-label={en ? 'Collapse section' : '收起章节'}
                          data-section-label={item.text}
                        ></button>
                      )}
                    </div>
                    {item.children.length > 0 && (
                      <ol
                        class="blog-toc-children"
                        id={'blog-toc-children-mobile-' + item.slug}
                        data-blog-toc-children={item.slug}
                        hidden
                      >
                        {item.children.map(child => (
                          <li>
                            <a class="blog-toc-link blog-toc-link--sub" href={'#' + child.slug} data-blog-toc-link={child.slug}>{child.text}</a>
                          </li>
                        ))}
                      </ol>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )}

        <div class="blog-prose"><slot /></div>
        <div class="blog-article-end"><a href={localeUrl(lang, 'blog')}>← {t.backAll}</a></div>
      </article>

      {hasToc && (
        <aside class="blog-toc-desktop">
          <div class="blog-toc-heading">
            <p class="blog-toc-title">{tocLabel}</p>
            <button
              class="blog-toc-global-toggle"
              type="button"
              data-blog-toc-global-toggle
              data-expand-label={en ? 'Expand all' : '全部展开'}
              data-collapse-label={en ? 'Collapse all' : '全部收起'}
              aria-label={en ? 'Expand all' : '全部展开'}
              aria-controls="blog-toc-list-desktop"
            >{en ? 'Expand all' : '全部展开'}</button>
          </div>
          <nav aria-label={tocLabel}>
            <ol class="blog-toc-list" id="blog-toc-list-desktop">
              {tocItems.map(item => (
                <li class="blog-toc-item" data-blog-toc-item={item.slug}>
                  <div class="blog-toc-item__row">
                    <a class="blog-toc-link blog-toc-link--chapter" href={'#' + item.slug} data-blog-toc-link={item.slug}>{item.text}</a>
                    {item.children.length > 0 && (
                      <button
                        class="blog-toc-toggle"
                        type="button"
                        aria-label={(en ? 'Expand section: ' : '展开章节：') + item.text}
                        aria-expanded="false"
                        aria-controls={'blog-toc-children-desktop-' + item.slug}
                        data-blog-toc-toggle={item.slug}
                        data-expand-label={en ? 'Expand section' : '展开章节'}
                        data-collapse-label={en ? 'Collapse section' : '收起章节'}
                        data-section-label={item.text}
                      ></button>
                    )}
                  </div>
                  {item.children.length > 0 && (
                    <ol
                      class="blog-toc-children"
                      id={'blog-toc-children-desktop-' + item.slug}
                      data-blog-toc-children={item.slug}
                      hidden
                    >
                      {item.children.map(child => (
                        <li>
                          <a class="blog-toc-link blog-toc-link--sub" href={'#' + child.slug} data-blog-toc-link={child.slug}>{child.text}</a>
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>
  </main>
  <BlogFooter {lang} />
  <script is:inline>
    // Markdown task-list checkboxes are read-only but still need accessible names.
    document.querySelectorAll('.blog-prose li.task-list-item').forEach(item => {
      const checkbox = item.querySelector('input[type="checkbox"]');
      if (checkbox && !checkbox.hasAttribute('aria-label')) {
        checkbox.setAttribute('aria-label', item.textContent.trim());
      }
    });

    // Keep both responsive TOCs synchronized. Normal use is single-open; after "Expand all", sections can be closed independently.
    (() => {
      const links = [...document.querySelectorAll('[data-blog-toc-link]')];
      const toggleButtons = [...document.querySelectorAll('[data-blog-toc-toggle]')];
      const globalToggleButtons = [...document.querySelectorAll('[data-blog-toc-global-toggle]')];
      const toggleSlugs = [...new Set(toggleButtons.map(button => button.getAttribute('data-blog-toc-toggle')).filter(Boolean))];
      const headings = [...document.querySelectorAll('.blog-prose h2[id], .blog-prose h3[id]')];
      if (!links.length || !headings.length) return;

      let openSlugs = new Set();
      const syncAccordion = (expandedSlugs) => {
        for (const button of toggleButtons) {
          const expanded = expandedSlugs.has(button.getAttribute('data-blog-toc-toggle'));
          const children = document.getElementById(button.getAttribute('aria-controls'));
          const label = button.getAttribute('data-section-label') || '';
          button.setAttribute('aria-expanded', String(expanded));
          button.setAttribute(
            'aria-label',
            (expanded ? button.getAttribute('data-collapse-label') : button.getAttribute('data-expand-label')) + ': ' + label
          );
          button.closest('.blog-toc-item')?.classList.toggle('is-expanded', expanded);
          if (children) children.hidden = !expanded;
        }
        const globalLabel = expandedSlugs.size > 0 ? 'data-collapse-label' : 'data-expand-label';
        globalToggleButtons.forEach(button => {
          const label = button.getAttribute(globalLabel) || '';
          button.textContent = label;
          button.setAttribute('aria-label', label);
        });
      };

      let scheduled = false;
      let lastActiveId = '';
      const updateActiveHeading = () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(() => {
          let activeHeading = headings[0];
          for (const heading of headings) {
            if (heading.getBoundingClientRect().top <= 150) activeHeading = heading;
            else break;
          }
          // The final section can remain below the reading line when the page
          // reaches its scroll limit, so explicitly activate it at page end.
          if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4) {
            activeHeading = headings[headings.length - 1];
          }

          // When an H3 is folded away, highlight its visible H2 parent instead.
          let activeChapter = activeHeading;
          const activeIndex = headings.indexOf(activeHeading);
          for (let i = activeIndex; i >= 0; i--) {
            if (headings[i].tagName === 'H2') {
              activeChapter = headings[i];
              break;
            }
          }
          const activeSubheadingIsVisible = activeHeading.tagName === 'H3' &&
            links.some(link =>
              link.getAttribute('data-blog-toc-link') === activeHeading.id &&
              link.getClientRects().length > 0
            );
          const activeLinkId = activeSubheadingIsVisible ? activeHeading.id : activeChapter.id;

          for (const link of links) {
            const active = link.getAttribute('data-blog-toc-link') === activeLinkId &&
              link.getClientRects().length > 0;
            link.classList.toggle('is-active', active);
            if (active) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }

          if (activeLinkId !== lastActiveId) {
            lastActiveId = activeLinkId;
            const visibleActiveLink = links.find(link =>
              link.getAttribute('data-blog-toc-link') === activeLinkId &&
              link.getClientRects().length > 0
            );
            visibleActiveLink?.scrollIntoView({ block: 'nearest', behavior: 'auto' });
          }
          scheduled = false;
        });
      };

      toggleButtons.forEach(button => {
        button.addEventListener('click', () => {
          const slug = button.getAttribute('data-blog-toc-toggle');
          if (openSlugs.has(slug)) {
            const nextOpenSlugs = new Set(openSlugs);
            nextOpenSlugs.delete(slug);
            openSlugs = nextOpenSlugs;
          } else {
            openSlugs = openSlugs.size > 1 ? new Set([...openSlugs, slug]) : new Set([slug]);
          }
          syncAccordion(openSlugs);
          updateActiveHeading();
        });
      });

      globalToggleButtons.forEach(button => {
        button.addEventListener('click', () => {
          openSlugs = openSlugs.size > 0 ? new Set() : new Set(toggleSlugs);
          syncAccordion(openSlugs);
          updateActiveHeading();
        });
      });

      links.forEach(link => {
        link.addEventListener('click', () => {
          const details = link.closest('details');
          if (details) details.open = false;
        });
      });

      document.querySelectorAll('.blog-toc-mobile').forEach(details => {
        details.addEventListener('toggle', () => {
          lastActiveId = '';
          updateActiveHeading();
        });
      });
      window.addEventListener('scroll', updateActiveHeading, { passive: true });
      window.addEventListener('resize', updateActiveHeading);
      window.addEventListener('hashchange', updateActiveHeading);
      updateActiveHeading();
    })();
  </script>
</BaseLayout>