---
import SiteHeader from '../components/SiteHeader.astro';
import HomeSections from '../components/HomeSections.astro';
import { readLegacyPage } from '../lib/legacy';
import type { Lang } from '../lib/site';
interface Props { lang: Lang; kind: 'home' | 'prompts' }
const {lang,kind}=Astro.props;
const source=await readLegacyPage(kind,lang);
const bodyClass=kind==='prompts'?'prompts-page':'';
---
<!doctype html>
<html lang={lang === 'en'?'en':'zh-CN'}>
<head><Fragment set:html={source.head}/></head>
<body class={bodyClass}>
<Fragment set:html={source.beforeHeader}/>
<SiteHeader {lang} active={kind==='home'?'home':'prompts'}/>
<Fragment set:html={source.beforeSection}/>
{kind==='home' && <HomeSections {lang}/>}
<Fragment set:html={source.afterSection}/>
</body>
</html>
