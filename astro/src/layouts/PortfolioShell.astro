---
import BaseLayout from './BaseLayout.astro';
import { localeUrl, localizedPath, type Lang } from '../lib/site';
import promptCatalogue from '../data/prompts.json';
import { dictionary } from '../lib/translation';
interface Props {lang:Lang;kind:'home'|'prompts';promptId?:string}
const {lang,kind,promptId}=Astro.props;
const prompt=promptId ? promptCatalogue.find(item=>item.id===promptId) : undefined;
if(promptId && !prompt) throw new Error('Unknown prompt ID: '+promptId);
const home=kind==='home';
const t=dictionary(lang).portfolio;
const title=home?t.homeTitle:prompt?(prompt[lang].title+' — Licat Prompts'):t.promptsTitle;
const description=home?t.homeDescription:prompt?prompt[lang].summary:
 `${t.promptsDescriptionBefore}${promptCatalogue.length}${t.promptsDescriptionAfter}`;
const canonical=prompt ? localizedPath(lang,'prompts',prompt.id) : localeUrl(lang,kind);
const zhHref=prompt ? localizedPath('zh','prompts',prompt.id) : localeUrl('zh',kind);
const enHref=prompt ? localizedPath('en','prompts',prompt.id) : localeUrl('en',kind);
const styles=home?[
 '/assets/vendor/open-props/open-props-core-1.7.23.min.css',
 '/assets/portfolio.css?v=20261008-glass1',
 '/assets/site-header.css?v=20261028-ai-glass1',
 '/assets/portfolio-liquid-glass.css?v=20261028-ai-active-group1',
 '/assets/portfolio-entrances.css?v=20261010-semantic1',
 '/assets/portfolio-skills.css?v=20261010-semantic1',
 '/assets/portfolio-journey-v2.css?v=20261011-v2',
 '/assets/portfolio-prompts.css?v=20261021a',
 '/assets/site-sections.css?v=20261027-ia1'
]:[
 '/assets/vendor/open-props/open-props-core-1.7.23.min.css',
 '/prompts/prompt-library.css?v=20261024b',
 '/assets/site-header.css?v=20261028-ai-glass1',
 '/assets/portfolio-liquid-glass.css?v=20261028-ai-active-group1'
];
---
<BaseLayout {lang} active={kind} {title} {description} {canonical} {zhHref} {enHref}
            {styles} exactTitle={true} includeSiteNavScript={false} includeLensFilter={false}
            pageClass={home?'':'prompts-page'}>
  {!home && <script slot="head" is:inline defer src="/prompts/prompt-library.js?v=20261028-routes1"></script>}
  <slot />
</BaseLayout>
