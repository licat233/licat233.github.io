---
import SiteHeader from '../components/SiteHeader.astro';
import type { Lang } from '../lib/site';
interface Props {lang:Lang;kind:'home'|'prompts'}
const {lang,kind}=Astro.props;
const en=lang==='en',home=kind==='home';
const title=home?(en?'Licat — Builder & Developer':'Licat — 开发者与系统构建者'):(en?'AI Prompt Library — Licat':'AI 提示词库 · Prompt Library — Licat');
const description=home
 ? (en?'Licat — developer building practical AI systems, developer tools and automation.':'Licat — 构建实用 AI 系统、开发者工具与自动化。')
 : (en?'15 curated AI prompts for agent workflows, writing, development and critical thinking; three longer prompts remain in original Chinese.':'Licat 的 AI 提示词库：15 条经过整理的实用提示词，涵盖 Agent 执行、AI 自然交流、Codex、视觉设计、独立思考与工作流。支持分类搜索、一键复制和独立分享。');
const url=(en?'/en/':'/')+(home?'':'prompts/');
const zhUrl=home?'/':'/prompts/', enUrl=home?'/en/':'/en/prompts/';
const css=home?[
 '/assets/vendor/open-props/open-props-core-1.7.23.min.css',
 '/assets/portfolio.css?v=20261008-glass1',
 '/assets/site-header.css?v=20261027-arch1',
 '/assets/portfolio-liquid-glass.css?v=20261010-perf1',
 '/assets/portfolio-entrances.css?v=20261010-semantic1',
 '/assets/portfolio-skills.css?v=20261010-semantic1',
 '/assets/portfolio-journey-v2.css?v=20261011-v2',
 '/assets/portfolio-prompts.css?v=20261021a',
 '/assets/site-sections.css?v=20261027-ia1'
]:[
 '/assets/vendor/open-props/open-props-core-1.7.23.min.css',
 '/prompts/prompt-library.css?v=20261024b',
 '/assets/site-header.css?v=20261027-arch1',
 '/assets/portfolio-liquid-glass.css?v=20261010-perf1'
];
---
<!doctype html>
<html lang={en?'en':'zh-CN'}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f2f7fa" media="(prefers-color-scheme:light)" />
<meta name="theme-color" content="#111416" media="(prefers-color-scheme:dark)" />
<meta name="description" content={description}/>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Licat / 233"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={'https://licat233.github.io'+url}/>
<link rel="canonical" href={'https://licat233.github.io'+url}/>
<link rel="alternate" hreflang="zh-CN" href={'https://licat233.github.io'+zhUrl}/>
<link rel="alternate" hreflang="en" href={'https://licat233.github.io'+enUrl}/>
{home && <link rel="alternate" hreflang="x-default" href="https://licat233.github.io/"/>}
<link rel="icon" href="/assets/licat-logo.svg" type="image/svg+xml"/>
<link rel="alternate icon" href="/favicon.ico"/>
<title>{title}</title>
<script is:inline>(()=>{try{const t=localStorage.getItem('licat-theme');document.documentElement.dataset.theme=t==='light'||t==='dark'?t:(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light')}catch(_){document.documentElement.dataset.theme='light'}})();</script>
{css.map(href=><link rel="stylesheet" href={href}/>)}
{!home && <script is:inline defer src="/prompts/prompt-library.js?v=20261027-arch1"></script>}
</head>
<body class={home?undefined:'prompts-page'}>
<SiteHeader {lang} active={kind}/>
<slot/>
</body>
</html>
