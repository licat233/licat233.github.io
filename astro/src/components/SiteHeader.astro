---
import { nav, localeUrl, type Lang, type NavKey } from '../lib/site';
interface Props { lang: Lang; active: NavKey; zhHref?: string; enHref?: string; }
const { lang, active, zhHref = localeUrl('zh', active), enHref = localeUrl('en', active) } = Astro.props;
---
<header class="liquid-demo site-header apple-glass-base apple-glass-ultra-thin">
  <span class="lg-glass-filter" aria-hidden="true"></span><span class="lg-glass-overlay" aria-hidden="true"></span><span class="lg-glass-specular" aria-hidden="true"></span>
  <nav class="shell nav" aria-label={lang === 'en' ? 'Primary navigation' : '主导航'}>
    <a class="brand" href={lang === 'en' ? '/en/' : '/'} aria-label={lang === 'en' ? 'Licat homepage' : 'Licat 个人主页'}>
      <img src="/assets/licat-logo.svg" alt="" /><span><strong>LICAT</strong><small>/ 233</small></span>
    </a>
    <div class="nav-links">
      <span class="nav-indicator" aria-hidden="true"></span>
      {nav.map(n => <a class:list={['nav-pill', { active: n.key === active }]} href={lang === 'en' ? n.enUrl : n.zhUrl} aria-current={n.key === active ? 'page' : undefined}><span></span>{lang === 'en' ? n.en : n.zh}</a>)}
    </div>
    <div class="nav-actions">
      <button class="liquid-demo theme-toggle" id="theme-toggle" type="button" aria-label={lang === 'en' ? 'Toggle theme' : '切换昼夜模式'} aria-pressed="false">
        <span class="lg-glass-filter" aria-hidden="true"></span><span class="lg-glass-overlay" aria-hidden="true"></span><span class="lg-glass-specular" aria-hidden="true"></span>
        <span class="theme-toggle-track" aria-hidden="true">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3M4 4l2.2 2.2m11.6 11.6L20 20M4 20l2.2-2.2M17.8 6.2L20 4" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.3A8.2 8.2 0 0 1 8.7 4a8.5 8.5 0 1 0 11.3 11.3Z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </span>
      </button>
      <div class="liquid-demo lang" aria-label="Language">
        <span class="lg-glass-filter" aria-hidden="true"></span><span class="lg-glass-overlay" aria-hidden="true"></span><span class="lg-glass-specular" aria-hidden="true"></span>
        <a href={zhHref} aria-current={lang === 'zh' ? 'page' : undefined}>中</a>
        <a href={enHref} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </div>
      <a class="liquid-demo github-cta" href="https://github.com/licat233" target="_blank" rel="noreferrer"><span class="lg-glass-filter" aria-hidden="true"></span><span class="lg-glass-overlay" aria-hidden="true"></span><span class="lg-glass-specular" aria-hidden="true"></span><svg class="github-mark" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7C5.73.7.75 5.68.75 11.95c0 5.01 3.25 9.26 7.76 10.76.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.15.68-3.81-1.34-3.81-1.34-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.33.96.1-.74.4-1.25.73-1.54-2.52-.29-5.17-1.26-5.17-5.58 0-1.23.44-2.24 1.16-3.03-.12-.29-.5-1.46.11-2.99 0 0 .95-.3 3.11 1.16a10.8 10.8 0 0 1 5.66 0c2.16-1.46 3.11-1.16 3.11-1.16.61 1.53.23 2.7.11 2.99.72.79 1.16 1.16 3.03 0 4.33-2.65 5.29-5.17 5.57.41.35.77 1.04.77 2.09 0 1.51-.01 2.73-.01 3.1 0 .3.21.65.79.54 4.5-1.5 7.75-5.75 7.75-10.76C23.25 5.68 18.27.7 12 .7Z"/></svg><span>GitHub</span><b>↗</b></a>
    </div>
  </nav>
</header>
