---
import { primaryNav, aiChildren, localeUrl, type Lang, type NavKey } from '../lib/site';
interface Props { lang: Lang; active: NavKey; zhHref?: string; enHref?: string; }
const { lang, active, zhHref = localeUrl('zh', active), enHref = localeUrl('en', active) } = Astro.props;
import GlassSurface from './GlassSurface.astro';
---
<GlassSurface as="header" class="site-header" material="ultra-thin">
  
  <nav class="shell nav" aria-label={lang === 'en' ? 'Primary navigation' : '主导航'}>
    <a class="brand" href={localeUrl(lang, 'home')} aria-label={lang === 'en' ? 'Licat homepage' : 'Licat 个人主页'}>
      <img src="/assets/licat-logo.svg" alt="" /><span><strong>LICAT</strong><small>/ 233</small></span>
    </a>
    <div class="nav-links">
      <span class="nav-indicator" aria-hidden="true"></span>
      {primaryNav.map(n => n.key === 'ai' ? (
        <div class="nav-group" data-nav-group="ai">
          <a class:list={['nav-pill', { active: active === 'ai' || active === 'skills' || active === 'prompts' }]}
            href={lang === 'en' ? n.enUrl : n.zhUrl}
            data-nav-section-current={active === 'skills' || active === 'prompts' ? 'location' : undefined}
            aria-current={active === 'ai' ? 'page' : active === 'skills' || active === 'prompts' ? 'location' : undefined}>
            <span></span>{lang === 'en' ? n.en : n.zh}
          </a>
          <button class="nav-submenu-trigger" type="button" aria-controls="ai-subnav"
            aria-expanded="false" aria-label={lang === 'en' ? 'AI subcategories' : '展开 AI 子栏目'}>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <GlassSurface as="div" class="ai-subnav" id="ai-subnav" material="regular"
            role="group" aria-label={lang === 'en' ? 'AI subcategories' : 'AI 子栏目'} hidden>
            {aiChildren.map(child => <a href={lang === 'en' ? child.enUrl : child.zhUrl}
              aria-current={active === child.key ? 'page' : undefined}>
              {lang === 'en' ? child.en : child.zh}
            </a>)}
          </GlassSurface>
        </div>
      ) : (
        <a class:list={['nav-pill', { active: n.key === active }]}
          href={lang === 'en' ? n.enUrl : n.zhUrl}
          aria-current={n.key === active ? 'page' : undefined}><span></span>{lang === 'en' ? n.en : n.zh}</a>
      ))}
    </div>
    <div class="nav-actions">
      <GlassSurface as="button" class="theme-toggle" id="theme-toggle" type="button" aria-label={lang === 'en' ? 'Toggle theme' : '切换昼夜模式'} aria-pressed="false">
        
        <span class="theme-toggle-track" aria-hidden="true">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3M4 4l2.2 2.2m11.6 11.6L20 20M4 20l2.2-2.2M17.8 6.2L20 4" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.3A8.2 8.2 0 0 1 8.7 4a8.5 8.5 0 1 0 11.3 11.3Z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </span>
      </GlassSurface>
      <GlassSurface class="lang" aria-label="Language">
        
        <a data-locale="zh" href={zhHref} aria-current={lang === 'zh' ? 'page' : undefined}>中</a>
        <a data-locale="en" href={enHref} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </GlassSurface>
      <GlassSurface as="a" class="github-cta" href="https://github.com/licat233" target="_blank" rel="noreferrer"><svg class="github-mark" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .297a12 12 0 0 0-3.793 23.386c.6.111.82-.261.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.757-1.333-1.757-1.09-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.304-5.466-1.333-5.466-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.323 3.301 1.23a11.527 11.527 0 0 1 6.007 0c2.291-1.553 3.297-1.23 3.297-1.23.655 1.652.243 2.873.12 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.804 5.624-5.475 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.216.694.825.576A12.004 12.004 0 0 0 12 .297z"/></svg><span>GitHub</span><b>↗</b></GlassSurface>
    </div>
  </nav>
</GlassSurface>
