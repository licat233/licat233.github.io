---
import type { Lang } from '../../lib/site';
import type { Resource } from '../../lib/resources';

interface Props {
  item: Resource;
  lang: Lang;
  cardId: string;
  categoryLabel: string;
  pricingLabel: string;
  featuredLabel: string;
  saveLabel: string;
  savedLabel: string;
  removeSavedLabel: string;
  isResult?: boolean;
  isInitiallyNearViewport?: boolean;
}

const {
  item, lang, cardId, categoryLabel, pricingLabel, featuredLabel,
  saveLabel, savedLabel, removeSavedLabel, isResult = true, isInitiallyNearViewport = false,
} = Astro.props;
const locale = lang === 'en' ? 'en' : 'zh-CN';
const name = item.name[locale];
const description = item.description[locale];
const site = new URL(item.url);

---
<article class:list={['rd-card', isInitiallyNearViewport && 'is-near-viewport']} id={cardId} data-resource-id={item.id}
  data-resource-card={isResult ? item.id : undefined}
  data-pricing={item.pricing} data-tags={item.tags.join('|')}
  data-platforms={item.platforms.join('|')}>
  <span class="rd-card-icon" aria-hidden="true">
    <span class="rd-icon-fallback">{name.trim().slice(0, 1).toUpperCase()}</span>
    <img data-favicon-host={site.hostname} data-favicon-origin={site.origin}
      data-favicon-custom={item.iconUrl || undefined}
      alt="" loading="lazy" decoding="async" fetchpriority="low" referrerpolicy="no-referrer" />
  </span>
  <div class="rd-card-copy">
    <p class="rd-card-kicker">{categoryLabel}{item.featured && <span class="rd-featured">{featuredLabel}</span>}</p>
    <a class="rd-card-title" href={item.url} target="_blank" rel="noopener noreferrer">{name}</a>
    <p class="rd-card-description">{description}</p>
    <div class="rd-card-bottom">
      <span class="rd-mini-tag rd-pricing">{pricingLabel}</span>
      {item.tags.slice(0, 2).map(tag => <span class="rd-mini-tag">{tag}</span>)}
    </div>
  </div>
  <button class="rd-save" type="button" data-save-id={item.id}
    aria-label={saveLabel} aria-pressed="false"
    data-save-label={saveLabel} data-saved-label={savedLabel}
    data-remove-saved-label={removeSavedLabel}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 4.75h11a1 1 0 0 1 1 1v14l-6.5-3.9-6.5 3.9v-14a1 1 0 0 1 1-1Z"></path></svg>
  </button>
</article>
