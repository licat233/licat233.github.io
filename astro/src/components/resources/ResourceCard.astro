---
import GlassSurface from '../GlassSurface.astro';
import type { Lang } from '../../lib/site';
import type { Resource } from '../../lib/resources';

interface Props {
  item: Resource;
  lang: Lang;
  cardId: string;
  categoryLabel: string;
  pricingLabel: string;
  visitLabel: string;
  saveLabel: string;
  savedLabel: string;
  removeSavedLabel: string;
  isResult?: boolean;
}

const {
  item, lang, cardId, categoryLabel, pricingLabel, visitLabel,
  saveLabel, savedLabel, removeSavedLabel, isResult = false,
} = Astro.props;
const locale = lang === 'en' ? 'en' : 'zh-CN';
const name = item.name[locale];
const description = item.description[locale];
---
<GlassSurface as="article" class="resource-card" material="regular"
  id={cardId} data-resource-id={item.id} data-resource-card={isResult ? item.id : undefined}
  data-category={item.category ?? ''} data-subcategory={item.subcategory ?? ''}
  data-pricing={item.pricing} data-tags={item.tags.join('|')}
  data-platforms={item.platforms.join('|')}>
  <div class="resource-card__top">
    <div class="resource-card__identity">
      <span class="resource-card__icon" aria-hidden="true">
        <span class="resource-card__icon-fallback">{name.trim().slice(0, 1).toUpperCase()}</span>
        {item.iconUrl && <img src={item.iconUrl} alt="" loading="lazy" decoding="async"
          referrerpolicy="no-referrer" data-resource-icon />}
      </span>
      <div class="resource-card__meta">
        <span>{categoryLabel}</span>
        <span class="resource-card__pricing" data-pricing={item.pricing}>{pricingLabel}</span>
      </div>
    </div>
    <button class="resource-card__save" type="button" data-favorite-id={item.id}
      aria-label={saveLabel} aria-pressed="false"
      data-save-label={saveLabel} data-saved-label={savedLabel}
      data-remove-saved-label={removeSavedLabel}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 4.75h11a1 1 0 0 1 1 1v14l-6.5-3.9-6.5 3.9v-14a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <div class="resource-card__body">
    <h3><a href={item.url} target="_blank" rel="noopener noreferrer">{name}</a></h3>
    <p class="resource-card__description">{description}</p>
    {item.tags.length > 0 && <div class="resource-card__tags" aria-label={lang === 'en' ? 'Tags' : '标签'}>
      {item.tags.slice(0, 4).map(tag => <span>{tag}</span>)}
    </div>}
  </div>
  <div class="resource-card__footer">
    <div class="resource-card__platforms">
      {item.platforms.slice(0, 2).map(platform => <span>{platform}</span>)}
      {item.platforms.length > 2 && <span>+{item.platforms.length - 2}</span>}
    </div>
    <a class="resource-card__visit" href={item.url} target="_blank" rel="noopener noreferrer">
      {visitLabel} <span aria-hidden="true">↗</span>
    </a>
  </div>
</GlassSurface>
