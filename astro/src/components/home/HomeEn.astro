---
import HomeSections from '../HomeSections.astro';
import FeaturedProjects from './FeaturedProjects.astro';
import HomeSkills from './HomeSkills.astro';
import GlassSurface from '../GlassSurface.astro';
import promptCatalogue from '../../data/prompts.json';
---
<main id="top">
    <section class="hero-wrap">
      <div class="flow-glow flow-glow-a" aria-hidden="true"></div>
      <div class="flow-glow flow-glow-b" aria-hidden="true"></div>

      <div class="system-flow" aria-hidden="true">
        <svg viewBox="0 0 1800 660" preserveAspectRatio="none">
          <defs>
            <linearGradient id="flow-blue-en" x1="0%" y1="62%" x2="100%" y2="22%">
              <stop offset="0%" stop-color="#45b8f1" stop-opacity=".76"/>
              <stop offset="34%" stop-color="#168fd5" stop-opacity=".93"/>
              <stop offset="67%" stop-color="#28c8df" stop-opacity=".82"/>
              <stop offset="100%" stop-color="#69e0e0" stop-opacity=".62"/>
            </linearGradient>
            <linearGradient id="flow-cyan-en" x1="0%" y1="70%" x2="100%" y2="18%">
              <stop offset="0%" stop-color="#9fe8f8" stop-opacity=".34"/>
              <stop offset="38%" stop-color="#5bd7ed" stop-opacity=".58"/>
              <stop offset="72%" stop-color="#31d5cf" stop-opacity=".76"/>
              <stop offset="100%" stop-color="#86eee3" stop-opacity=".50"/>
            </linearGradient>
            <linearGradient id="flow-light-en" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0"/>
              <stop offset="28%" stop-color="#ffffff" stop-opacity=".74"/>
              <stop offset="72%" stop-color="#e8ffff" stop-opacity=".82"/>
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="flow-shadow-en" x1="0%" y1="50%" x2="100%" y2="20%">
              <stop offset="0%" stop-color="#8ab8d1" stop-opacity=".12"/>
              <stop offset="52%" stop-color="#6ba5c4" stop-opacity=".18"/>
              <stop offset="100%" stop-color="#84cfda" stop-opacity=".08"/>
            </linearGradient>
          </defs>

          <path class="flow-ribbon-shadow"
            d="M-150 242
               C120 306 284 388 458 332
               C620 280 672 56 864 28
               C1068 -2 1134 132 1352 116
               C1530 104 1636 6 1880 -30
               L1880 82
               C1654 116 1546 214 1362 224
               C1134 238 1044 102 876 130
               C690 162 654 372 474 432
               C276 498 86 404 -150 340 Z"
            fill="url(#flow-shadow-en)"/>

          <path class="flow-ribbon-back"
            d="M-160 198
               C96 256 290 334 446 290
               C624 240 674 24 864 0
               C1060 -24 1140 94 1342 84
               C1528 76 1662 -8 1880 -30
               L1880 34
               C1650 62 1532 150 1346 164
               C1134 178 1058 62 872 88
               C690 112 646 320 462 372
               C286 420 84 334 -160 278 Z"
            fill="url(#flow-cyan-en)"/>

          <path class="flow-ribbon-main"
            d="M-160 226
               C94 286 282 362 446 314
               C610 266 682 76 856 42
               C1056 2 1146 118 1344 108
               C1530 98 1648 26 1880 -12
               L1880 64
               C1658 102 1540 184 1352 192
               C1136 202 1058 88 872 122
               C700 154 650 342 470 394
               C286 448 86 366 -160 306 Z"
            fill="url(#flow-blue-en)"/>

          <path class="flow-ribbon-front"
            d="M-148 266
               C100 326 286 394 460 348
               C616 306 688 138 850 98
               C1048 48 1140 152 1348 148
               C1536 144 1668 72 1886 40
               L1886 88
               C1662 124 1542 198 1358 208
               C1138 220 1060 112 878 150
               C714 184 656 360 478 412
               C290 466 86 388 -148 330 Z"
            fill="url(#flow-cyan-en)"
            opacity=".72"/>

          <path class="flow-rim flow-rim-a"
            d="M-130 220
               C112 276 288 348 446 302
               C612 254 680 76 858 42
               C1056 2 1148 116 1344 106
               C1534 98 1652 28 1870 -6"
            stroke="url(#flow-light-en)"/>

          <path class="flow-rim flow-rim-b"
            d="M-118 322
               C112 374 294 430 462 388
               C622 348 696 176 856 136
               C1046 88 1140 184 1346 180
               C1530 178 1654 114 1860 82"
            stroke="url(#flow-light-en)"
            opacity=".58"/>
        </svg>
      </div>

      <div class="hero-ghost" aria-hidden="true">LICAT&nbsp;/&nbsp;SYSTEMS</div>

      <figure class="hero-scene" aria-hidden="true">
        <img src="/assets/licat-hero.webp" alt="">
      </figure>

      <div class="shell hero">
        <p class="eyebrow">BUILD SYSTEMS · REAL PROBLEMS · 2026</p>

        <h1 class="hero-title">
          <span class="hero-line"><span class="hero-word">BUILD SYSTEMS</span></span>
          <span class="hero-line hero-line-mixed">
            <span class="hero-inline-note">From developer tools and automation to AI agents and enterprise systems — compressing recurring friction into shorter paths.</span>
            <span class="hero-paren">(</span>
            <span class="hero-logo-token"><img src="/assets/licat-logo.svg" alt=""></span>
            <span class="hero-signal">AI / SYSTEM</span>
            <span class="hero-paren">)</span>
            <span class="hero-word">FOR REAL</span>
          </span>
          <span class="hero-line"><span class="hero-word hero-accent">PROBLEMS.</span></span>
        </h1>

        <div class="hero-badge" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <defs>
              <path id="ring-en" d="M60,60 m-45,0 a45,45 0 1,1 90,0 a45,45 0 1,1 -90,0"/>
            </defs>
            <text><textPath href="#ring-en">BUILD · SYSTEMS · REAL PROBLEMS · </textPath></text>
          </svg>
          <span><img src="/assets/licat-logo.svg" alt=""></span>
        </div>

        <div class="hero-bottom">
          <div class="hero-actions">
            <a class="hero-cta hero-cta-dark" href="#projects">View projects <b>↘</b></a>
            <GlassSurface as="a" class="hero-cta" href="/eao/">
    <span class="lg-label">EAO</span> <b>↗</b></GlassSurface>
          </div>

          <GlassSurface class="hero-resources" aria-label="Current focus">
    
            <a class="hero-resource active" href="/eao/"><span>Flagship</span><strong>Enterprise AI Office</strong><b>↗</b></a>
            <a class="hero-resource" href="/toolscout/en/"><span>Agent tools</span><strong>ToolScout</strong><b>↗</b></a>
            <a class="hero-resource" href="/ai-writing-audit/"><span>Active</span><strong>ai-writing-audit</strong><b>↗</b></a>
          </GlassSurface>
        </div>
      </div>
    </section>

    <HomeSections lang="en" />

    <section class="section" id="projects">
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="kicker">FEATURED PROJECTS</p>
            <h2>Featured Projects</h2>
          </div>
          <p class="section-note">Not a repository dump — these are projects with external signal, active maintenance, deep investment or a distinct idea.</p>
        </div>
        <FeaturedProjects lang="en" />
      </div>
    </section>

    <HomeSkills lang="en" />

    
    <section class="section prompt-showcase" id="prompts">
      <div class="shell">
        <a class="prompt-showcase-card" href="/en/prompts/" aria-label="Browse Licat's AI Prompt Library">
          <div>
            <span class="prompt-showcase-kicker">THE PROMPT LIBRARY / CURATED NOTES</span>
            <h2>Better prompts. Better work.</h2>
            <p>A collection of {promptCatalogue.length} practical, reusable prompts I have gathered and refined: clear AI communication, independent thinking, agent execution, Codex workflows and visual design. Original entries are in Chinese.</p>
            <span class="prompt-showcase-cta">Explore all {promptCatalogue.length} prompts ↗</span>
          </div>
          <div class="prompt-showcase-art" aria-hidden="true"><span>{'{ / }'}</span></div>
        </a>
      </div>
    </section>

    <section class="section journey" id="journey">
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="kicker">JOURNEY</p>
            <h2>Development Journey</h2>
          </div>
          <p class="section-note">The direction changes; the through-line stays the same: reduce repetition, friction and unnecessary complexity.</p>
        </div>
        <div class="journey-story" id="story">
          <div class="journey-art-pane" id="stage-frame" role="group" aria-label="Animated evolution of development capabilities">
            <div class="stage-caption"><span>CAPABILITY SYSTEM</span><span class="stage-status"><span class="status-disc"></span> CONTINUOUS EVOLUTION</span></div>
<svg class="capability-svg" viewBox="0 0 900 640" role="img" aria-labelledby="diagramTitle diagramDesc">
<title id="diagramTitle">Continuously evolving capability system</title>
<desc id="diagramDesc">The journey evolves from a single development core into a connected automation process and then a five-node AI collaboration network. Scroll to explore each stage.</desc>
<defs>
<path id="shape-build" d="M-30-27H19Q30-27 30-16V17Q30 27 19 27H-19Q-30 27-30 16V-16Q-30-27-19-27Z"/>
<path id="shape-flow" d="M-37-16 H12 Q25-16 25-29 L43 0 L25 29 Q25 16 12 16 H-37 Q-42 16-42 10 V-10 Q-42-16-37-16Z"/>
<path id="shape-network" d="M0-36 L31-18 L31 18 L0 36 L-31 18 L-31-18Z"/>
</defs>
<g class="guide-lines" aria-hidden="true"><path d="M70 100 H830 M70 320 H830 M70 540 H830 M100 70 V580 M450 70 V580 M800 70 V580"/></g>
<g class="mesh-wiring" fill="none" aria-hidden="true">
<path class="mesh-wire" d="M450 244 Q318 248 210 311"/>
<path class="mesh-wire" d="M450 244 Q582 248 690 311"/>
<path class="mesh-wire" d="M210 449 Q274 455 350 481"/>
<path class="mesh-wire" d="M690 449 Q626 455 550 481"/>
<path class="mesh-wire" d="M210 449 Q450 475 690 449"/>
<path class="mesh-wire" d="M350 599 Q450 623 550 599"/>
</g>
<path id="process-line" d="M230 310 H670" fill="none" aria-hidden="true"/>
<circle id="process-traveler" cx="0" cy="0" r="10" aria-hidden="true"/>
<g class="node-wrap" transform="translate(450 310)">
<g id="node-core" class="node" transform="translate(0 -155)">
<rect class="node-surface node-primary" x="-93" y="-89" width="186" height="178" rx="20"/>
<path id="morph-core" d="M-30-27H19Q30-27 30-16V17Q30 27 19 27H-19Q-30 27-30 16V-16Q-30-27-19-27Z" class="morph-core"/>
<text class="node-title" x="0" y="58">BUILD · SYSTEM</text>
</g>
<g id="node-tools" class="node" transform="translate(-240 70)">
<rect class="node-surface" x="-86" y="-69" width="172" height="138" rx="18"/>
<path class="node-icon" d="M-30-19 H30 M-30-4 H13 M-30 12 H27"/>
<text class="node-title" x="0" y="48">TOOLS · AUTOMATE</text>
</g>
<g id="node-delivery" class="node" transform="translate(240 70)">
<rect class="node-surface" x="-86" y="-69" width="172" height="138" rx="18"/>
<path class="node-icon" d="M-29 0 H27 M14-13 29 0 14 13 M-26-21 V21"/>
<text class="node-title" x="0" y="48">DELIVER · SYSTEMS</text>
</g>
<g id="node-knowledge" class="node" transform="translate(-100 230)">
<rect class="node-surface" x="-75" y="-59" width="150" height="118" rx="18"/>
<path class="node-icon" d="M-25-16 Q-11-26 0-16 Q11-26 25-16 V18 Q10 9 0 19 Q-10 9-25 18 Z M0-16 V19"/>
<text class="node-title" x="0" y="43">KNOWLEDGE</text>
</g>
<g id="node-governance" class="node" transform="translate(100 230)">
<rect class="node-surface" x="-75" y="-59" width="150" height="118" rx="18"/>
<path class="node-icon" d="M0-27 L25-15 V5 Q22 23 0 29 Q-22 23-25 5 V-15 Z M-10 1 L-1 10 L13-8"/>
<text class="node-title" x="0" y="43">GOVERNANCE</text>
</g>
</g>
<g class="drawing-annotations" aria-hidden="true"><text x="70" y="70">SYSTEM ARCHITECTURE</text><text x="810" y="600" text-anchor="end">01 → 02 → 03</text></g>
</svg>
            <div class="stage-footer"><div class="phase-monitor"><span class="phase-monitor-number" id="monitor-phase">01</span><span class="phase-monitor-name" id="monitor-name">BUILD</span></div><div class="phase-progress"><span id="progress-fill"></span></div><span class="stage-footnote">REVERSIBLE SCROLL</span></div>
          </div>
          <div class="journey-story-steps">
          <article class="phase">
            <div class="phase-dot">01</div>
            <GlassSurface class="phase-glass">
    
              <time>2019 — 2022</time>
            <h3>Go / Web / Backend Systems</h3>
            <p>From Gin, WebSocket, Redis and crawling to microservices and small business systems — the backend and systems foundation.</p>
            </GlassSurface>
          </article>
          <article class="phase">
            <div class="phase-dot">02</div>
            <GlassSurface class="phase-glass">
    
              <time>2023 — 2024</time>
            <h3>Developer Tools / Automation</h3>
            <p>Code generation, asset processing, upgrade tools and automation scripts that compress repetitive workflows.</p>
            </GlassSurface>
          </article>
          <article class="phase">
            <div class="phase-dot">03</div>
            <GlassSurface class="phase-glass">
    
              <time>2026 → NOW</time>
            <h3>AI Agents / Enterprise AI Systems</h3>
            <p>From skills, agent tools and knowledge systems toward permissions, workflows, maintainable deployment and complete enterprise AI systems.</p>
            </GlassSurface>
          </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="principles">
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="kicker">PRINCIPLES</p>
            <h2>How I Build</h2>
          </div>
          <p class="section-note">Technology is a means. A good system should make the work simpler, not make people adapt to the system.</p>
        </div>
        <div class="principles">
          <GlassSurface as="article" class="principle" material="regular">
    
            <span class="principle-icon">◎</span><span class="principle-no">01</span>
            <h3>Real Problems</h3>
            <p>Start from an actual need or friction point, not from a technology looking for a problem.</p>
          </GlassSurface>
          <GlassSurface as="article" class="principle" material="regular">
    
            <span class="principle-icon">◇</span><span class="principle-no">02</span>
            <h3>Smallest Sufficient Solution</h3>
            <p>Reuse mature capabilities when possible; if a smaller solution is enough, don't introduce a larger system.</p>
          </GlassSurface>
          <GlassSurface as="article" class="principle" material="regular">
    
            <span class="principle-icon">↻</span><span class="principle-no">03</span>
            <h3>Maintainability</h3>
            <p>Deployment, upgrades, rollback and long-term maintenance are part of the product, not afterthoughts.</p>
          </GlassSurface>
        </div>
      </div>
    </section>
  </main>

  <GlassSurface as="footer" class="site-footer" material="ultra-thin">
    
    <div class="shell footer-row">
      <div class="footer-brand">
        <img src="/assets/licat-logo.svg" alt="">
        <div><strong>LICAT</strong><small>Turn complex problems into systems.</small></div>
      </div>
      <div class="footer-links">
        <a href="https://github.com/licat233" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="#projects">Projects</a>
        <a href="#skills">Skills</a>
        <a href="/en/prompts/">Prompts</a>
      </div>
      <div class="footer-note">Better tools, more effective work, and a more self-directed life.</div>
    </div>
  </GlassSurface>
  <!-- Narrow optical distortion is borrowed from the MIT-licensed CodePen demo. -->
  <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute;overflow:hidden;pointer-events:none">
    <filter id="portfolioLensFilter" x="-6%" y="-15%" width="112%" height="130%" color-interpolation-filters="sRGB">
      <feGaussianBlur in="SourceAlpha" stdDeviation="12" result="edgeFade"/>
      <feDisplacementMap in="SourceGraphic" in2="edgeFade" scale="12" xChannelSelector="A" yChannelSelector="A"/>
    </filter>
    <!-- Restore the original Demo optical parameters on project glass only. -->
    <filter id="portfolioCardLensFilter" x="-6%" y="-10%" width="112%" height="120%" color-interpolation-filters="sRGB">
      <feGaussianBlur in="SourceAlpha" stdDeviation="50" result="cardEdgeFade"/>
      <feDisplacementMap in="SourceGraphic" in2="cardEdgeFade" scale="32" xChannelSelector="A" yChannelSelector="A"/>
    </filter>
  </svg>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/ScrollTrigger.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/SplitText.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/MorphSVGPlugin.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/DrawSVGPlugin.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/MotionPathPlugin.min.js"></script>
  <script is:inline src="/assets/site-nav.js?v=20261028-ai-active-group1"></script>
  <script is:inline src="/assets/portfolio-motion.js?v=20261027-arch1"></script>
  <script is:inline src="/assets/portfolio-journey-v2.js?v=20261011-v2"></script>
  
