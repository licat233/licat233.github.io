---
import type { Lang } from '../../lib/site';
import { getSkills } from '../../lib/catalog';
import { dictionary } from '../../lib/translation';
interface Props {lang:Lang}
const {lang}=Astro.props;
const en=lang==='en';
const t=dictionary(lang).homeSkills;
const skills=await getSkills();
const github='https://github.com/licat233/licat233.github.io';
import GlassSurface from '../GlassSurface.astro';
---
<section class="section skills-section" id="skills" aria-labelledby="skills-heading">
  <div class="shell">
    <div class="section-head">
      <div><p class="kicker">REUSABLE KNOW-HOW</p><h2 id="skills-heading">Agent Skills</h2></div>
      <p class="section-note">{t.note}</p>
    </div>
    <div class="skills-grid">
      {skills.map((skill,i) => (
        <GlassSurface as="article" class="skill-card" material="regular">
          
          <div class="skill-card-content">
            <div class="skill-card-top"><span class="skill-index">{String(i+1).padStart(2,'0')}</span><span class="skill-domain">{en?skill.featured_en_domain:skill.featured_zh_domain}</span></div>
            <h3>{skill.name}</h3>
            <p class="skill-summary">{en?skill.featured_en_summary:skill.featured_zh_summary}</p>
            <div class="skill-usage"><h4>{t.usage}</h4>
              <ul>{(en?skill.featured_en_usage:skill.featured_zh_usage)?.map(text=><li>{text}</li>)}</ul>
            </div>
            <div class="skill-actions">
              <a class="skill-link" href={github+'/blob/main'+skill.source} target="_blank" rel="noopener noreferrer">{t.read} <span aria-hidden="true">↗</span></a>
              <a class="skill-source" href={github+'/tree/main'+skill.source.replace(/\/SKILL\.md$/,'')} target="_blank" rel="noopener noreferrer">{t.browse} <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </GlassSurface>
      ))}
    </div>
    <a class="skills-directory-link" href={github+'/tree/main/skills'} target="_blank" rel="noopener noreferrer">{t.browseAll} <span aria-hidden="true">↗</span></a>
  </div>
</section>
