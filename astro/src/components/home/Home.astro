            stroke={`url(#flow-light-${lang})`}
            opacity=".58"/>
        </svg>
      </div>

      <div class="hero-ghost" aria-hidden="true">LICAT&nbsp;/&nbsp;EXPLORE</div>

      <figure class="hero-scene" aria-hidden="true">
        <picture>
          <source media="(max-width: 760px)" srcset="/assets/licat-hero-mobile.webp" />
