        <div class="contact-copy">
          <p class="kicker">CONTACT / LICAT</p>
          <h2 id="contact-title">{t.contactTitle}</h2>
          <p class="contact-intro">{t.contactNote}</p>
          <div class="contact-direct" aria-label={t.contactAlternative}>
