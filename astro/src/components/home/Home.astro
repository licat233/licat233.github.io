            <a class="contact-direct-link" href="mailto:licat233@gmail.com">
              <span class="contact-direct-type">EMAIL</span>
              <span>licat233@gmail.com</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a class="contact-direct-link" href="https://github.com/licat233" target="_blank" rel="noopener noreferrer">
              <span class="contact-direct-type">GITHUB</span>
              <span>github.com/licat233</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <GlassSurface as="div" class="contact-form-panel" material="regular">
          <div id="contact-error" class="contact-sent contact-failed" role="alert">
            <strong>{t.contactErrorTitle}</strong>
            <p>{t.contactErrorNote}</p>
          </div>
          <div id="contact-sent" class="contact-sent" role="status">
            <span class="contact-sent-icon" aria-hidden="true">✓</span>
            <strong>{t.contactSuccessTitle}</strong>
            <p>{t.contactSuccessNote}</p>
          </div>
          <div class="contact-form-head">
            <span class="contact-form-index">01 / {lang === 'en' ? 'MESSAGE' : '留言'}</span>
            <h3>{t.contactFormTitle}</h3>
            <p>{t.contactFormIntro}</p>
          </div>
          <form class="contact-form" action="https://contact-api.licat.xyz/submit" method="POST">
            <input type="hidden" name="lang" value={lang} />
            <div class="contact-botcheck" aria-hidden="true">
              <label for={`contact-extra-${lang}`}>Leave this field empty</label>
