      </figure>

      <div class="shell hero">
        <p class="eyebrow">LICAT · EXPLORE & SIMPLIFY</p>

        <h1 class="hero-title hero-native-motion" style={titleTiming} aria-label={lang === 'en' ? t.heroFirst + ' ' + t.heroLast : t.heroFirst + t.heroLast}>
          <span class="hero-line hero-line-primary" aria-hidden="true">
            <span class="hero-word hero-word-primary">{firstLine.items.map(({char,timing})=>timing === null ? char : <span class="hero-char" style={`--glyph-delay:${timing}s`}>{char}</span>)}</span>
          </span>
          {lang === 'zh' ? (
            <span class="hero-line hero-line-script" aria-hidden="true">
              <HeroFreedomScript />
              <span class="hero-script-text">{t.heroLast}</span>
            </span>
          ) : (
            <span class="hero-line hero-line-script hero-line-english" aria-hidden="true">
              <span class="hero-word hero-word-secondary hero-word-english">
                <span class="hero-word-source">{secondLine.items.map(({char,timing},i)=>timing === null ? char : <span class="hero-char" style={`--glyph-delay:${timing}s;--scan-hit:${.5*(i+.5)/secondLine.items.length}s`}>{char}</span>)}</span>
                <span class="hero-scan-line" aria-hidden="true"></span>
              </span>
            </span>
          )}
        </h1>
        <p class="hero-subtitle">{t.heroNote}</p>

        <div class="hero-badge" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <defs>
              <path id={`ring-${lang}`} d="M60,60 m-45,0 a45,45 0 1,1 90,0 a45,45 0 1,1 -90,0"/>
            </defs>
            <text><textPath href={`#ring-${lang}`}>LICAT · EXPLORE · SIMPLIFY · </textPath></text>
          </svg>
          <span><img src="/assets/licat-logo.svg" alt=""></span>
        </div>

        <div class="hero-bottom">
          <div class="hero-actions">
            <a class="hero-cta hero-cta-dark" href="#projects">{t.projectsCta} <b>↘</b></a>
            <GlassSurface as="a" class="hero-cta" href={projectHref('Enterprise AI Office')}>
    <span class="lg-label">EAO</span> <b>↗</b></GlassSurface>
          </div>

          <GlassSurface class="hero-resources" aria-label={t.focusAria}>
    
            <a class="hero-resource active" href={projectHref('Enterprise AI Office')}><span>{t.focusFlagship}</span><strong>Enterprise AI Office</strong><b>↗</b></a>
            <a class="hero-resource" href={projectHref('ToolScout')}><span>{t.focusAgentTools}</span><strong>ToolScout</strong><b>↗</b></a>
            <a class="hero-resource" href={projectHref('armor-memory')}><span>{t.focusAgentMemory}</span><strong>armor-memory</strong><b>↗</b></a>
          </GlassSurface>
        </div>

        <script is:inline>
          (() => {
            const title = document.querySelector('.hero-native-motion');
            if (!title) return;
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
              title.dataset.motionState = 'complete';
              return;
            }
            const accent = title.querySelector('.hero-word-secondary');
            if (accent) requestAnimationFrame(() => {
              const width = accent.offsetWidth;
              if (!width) return;
              const hits = Array.from(accent.querySelectorAll('.hero-char'), char => ({
                char, hit: Math.max(0, Math.min(1, (char.offsetLeft + char.offsetWidth / 2) / width))
              }));
              hits.forEach(({char,hit})=>char.style.setProperty('--scan-hit', (.5 * hit) + 's'));
            });
            title.dataset.motionState = 'first-line';
            const script = title.querySelector('.hero-script-svg');
            const firstStroke = script?.querySelector('.hero-writing-stroke');
            if (firstStroke) {
              firstStroke.addEventListener('animationstart', () => title.dataset.motionState = 'second-line', {once:true});
              script.querySelector('.hero-writing-complete')?.addEventListener('animationend', () => {
                script.classList.add('is-written');
                title.dataset.motionState = 'complete';
              }, {once:true});
            } else {
              title.querySelector('.hero-word-source .hero-char')?.addEventListener('animationstart', () => title.dataset.motionState = 'second-line', {once:true});
              const scan = title.querySelector('.hero-scan-line');
              scan?.addEventListener('animationstart', () => title.dataset.motionState = 'scanning', {once:true});
              scan?.addEventListener('animationend', event => {
                if (event.animationName === 'hero-scan-opacity') title.dataset.motionState = 'complete';
              });
            }
          })();
        </script>
      </div>
    </section>

    <HomeSections lang={lang} />

    <section class="section" id="projects">
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="kicker">FEATURED PROJECTS</p>
            <h2>{t.projectsTitle}</h2>
