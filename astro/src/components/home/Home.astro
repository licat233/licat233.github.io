                <input id={`contact-name-${lang}`} name="name" type="text" autocomplete="name"
                       placeholder={t.contactNamePlaceholder} maxlength="100" required />
              </div>
              <div class="contact-field">
                <label for={`contact-email-${lang}`}>{t.contactEmail}<span aria-hidden="true"> *</span></label>
                <input id={`contact-email-${lang}`} name="email" type="email" autocomplete="email"
                       placeholder={t.contactEmailPlaceholder} maxlength="254" required />
              </div>
            </div>
            <div class="contact-field">
              <label for={`contact-message-${lang}`}>{t.contactMessage}<span aria-hidden="true"> *</span></label>
              <textarea id={`contact-message-${lang}`} name="message" rows="5"
                        placeholder={t.contactMessagePlaceholder} minlength="5" maxlength="5000" required></textarea>
            </div>
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAF_iQKhRftrl-h0o" data-theme="auto"></div>
            <div class="contact-form-bottom">
              <p class="contact-form-privacy">{t.contactPrivacy}</p>
              <button class="contact-submit" type="submit"><span>{t.contactSubmit}</span><span aria-hidden="true">↗</span></button>
            </div>
          </form>
        </GlassSurface>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const panel = document.querySelector('#contact .cf-turnstile');
      if (!panel) return;
      const loadTurnstile = () => {
        if (document.querySelector('script[data-contact-turnstile]')) return;
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
        script.async = true;
        script.defer = true;
        script.dataset.contactTurnstile = 'true';
        document.head.appendChild(script);
      };
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          if (entries.some(entry => entry.isIntersecting)) {
            observer.disconnect();
            loadTurnstile();
          }
        }, { rootMargin: '900px 0px' });
        observer.observe(panel);
      } else loadTurnstile();
    })();
  </script>
