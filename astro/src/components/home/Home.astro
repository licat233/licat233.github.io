---
import HomeSections from '../HomeSections.astro';
import FeaturedProjects from './FeaturedProjects.astro';
import HomeSkills from './HomeSkills.astro';
import HomeBlog from './HomeBlog.astro';
import GlassSurface from '../GlassSurface.astro';
import SiteFooter from '../SiteFooter.astro';
import HeroFreedomScript from './HeroFreedomScript.astro';
import promptCatalogue from '../../data/prompts.json';
import { dictionary } from '../../lib/translation';
import { localeUrl, type Lang } from '../../lib/site';
import { getProjects } from '../../lib/catalog';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dictionary(lang).home;
const projectList = await getProjects();
const projectHref = (name: string) => {
  const project = projectList.find(item => item.name === name);
  if (!project) throw new Error('Unknown homepage project: ' + name);
  return lang === 'en' ? project.en_url : project.zh_url;
};

const glyphLine = (text: string) => {
  const chars = Array.from(text);
  const count = chars.filter(c => !/\s/.test(c)).length;
  const stagger = Math.min(lang === 'zh' ? .04 : .055, .78 / Math.max(1, count - 1));
  let index = 0;
  return { count, stagger, items: chars.map(char => /\s/.test(char)
    ? { char, timing: null }
    : { char, timing: (index++) * stagger }) };
};
const firstLine = glyphLine(t.heroFirst);
const secondLine = glyphLine(t.heroLast);
const firstTime = (lang === 'zh' ? .52 : .76) + Math.max(0, firstLine.count - 1) * firstLine.stagger;
const secondStart = firstTime + (lang === 'zh' ? .04 : .10);
const secondTime = lang === 'zh' ? 2.1 : 1.01 + Math.max(0, secondLine.count - 1) * secondLine.stagger;
const scanStart = secondStart + secondTime + .03;
const titleTiming = `--hero-second-start:${secondStart}s;--hero-scan-start:${scanStart}s;--hero-writing-end:${secondStart + secondTime}s`;
---
<main id="top">
    <section class="hero-wrap">
      <div class="flow-glow flow-glow-a" aria-hidden="true"></div>
      <div class="flow-glow flow-glow-b" aria-hidden="true"></div>

      <div class="system-flow" aria-hidden="true">
        <svg viewBox="0 0 1800 660" preserveAspectRatio="none">
