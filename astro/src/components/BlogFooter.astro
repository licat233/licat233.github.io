---
import { localeUrl, type Lang } from '../lib/site';
import { dictionary } from '../lib/translation';
interface Props {lang:Lang}
const {lang}=Astro.props;
const t=dictionary(lang).blog;
---
<footer class="blog-footer">
 <span>© {new Date().getUTCFullYear()} Licat</span>
 <a href={localeUrl(lang,'home')}>{t.footer} <span aria-hidden="true">↗</span></a>
</footer>
