---
import PortfolioShell from '../../../layouts/PortfolioShell.astro';
import PromptLibrary from '../../../components/prompts/PromptLibrary.astro';
import catalogue from '../../../data/prompts.json';
import { localePaths } from '../../../lib/locale-routes';
import { localizedPath, type Lang } from '../../../lib/site';


export function getStaticPaths(){
const legacyRoutes: [string, string][] = [
 ['ai-natural-communication-v1.3', 'ai-natural-communication'],
 ['ai-natural-communication-v1.3.1', 'ai-natural-communication'],
 ['ai-natural-communication-v1.3.2', 'ai-natural-communication'],
 ['ai-natural-communication-v1.3.3', 'ai-natural-communication'],
 ['ai-natural-communication-v1.3.4', 'ai-natural-communication'],
 ['ai-natural-communication-v1.4.0', 'ai-natural-communication'],
 ['ai-high-value-writing-audit-v1.1', 'ai-high-value-writing-audit'],
 ['ai-agent-minimal-necessary-execution-v1', 'ai-agent-minimal-necessary-execution'],
 ['agent-efficient-execution-v3', 'agent-efficient-execution'],
 ['ai-coding-minimal-defensive-v1', 'ai-coding-minimal-defensive'],
];
 return localePaths().flatMap(route=>[
  ...catalogue.map(({id,slug})=>({
   params:{...route.params,id:slug},
   props:{id,lang:route.props.lang}
  })),
  ...legacyRoutes.map(([id,slug])=>({
   params:{...route.params,id},
   props:{lang:route.props.lang,redirectSlug:slug}
  }))
 ]);
}
interface Props {id?:string;lang:Lang;redirectSlug?:string}
const {id,lang,redirectSlug}=Astro.props;
if(redirectSlug)return Astro.redirect(localizedPath(lang,'prompts',redirectSlug),301);
if(!id)throw new Error('Prompt content ID missing for route: '+Astro.params.id);
---
<PortfolioShell {lang} kind="prompts" promptId={id}><PromptLibrary {lang} initialId={id} /></PortfolioShell>
