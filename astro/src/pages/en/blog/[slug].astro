---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogArticle from '../../../layouts/BlogArticle.astro';
import { blogSlug } from '../../../lib/site';
export async function getStaticPaths(){
 const posts=await getCollection('blog',({data})=>data.lang==='en');
 return posts.map(post=>({params:{slug:blogSlug(post.id)},props:{post}}));
}
interface Props { post:CollectionEntry<'blog'> }
const {post}=Astro.props;
const {Content}=await render(post);
const canonical='/en/blog/'+blogSlug(post.id)+'/';
---
<BlogArticle lang="en" {post} {canonical}><Content /></BlogArticle>
