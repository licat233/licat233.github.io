---
import PortfolioShell from '../../layouts/PortfolioShell.astro';
import PromptLibrary from '../../components/prompts/PromptLibrary.astro';
import catalogue from '../../data/prompts.json';

export function getStaticPaths(){
 return catalogue.map(({id})=>({params:{id},props:{id}}));
}
interface Props {id:string}
const {id}=Astro.props;
---
<PortfolioShell lang="zh" kind="prompts" promptId={id}><PromptLibrary lang="zh" initialId={id} /></PortfolioShell>
