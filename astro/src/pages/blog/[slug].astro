---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogArticle from '../../layouts/BlogArticle.astro';
import { blogSlug } from '../../lib/site';
export async function getStaticPaths(){
 const posts=await getCollection('blog',({data})=>data.lang==='zh');
 return posts.map(post=>({params:{slug:blogSlug(post.id)},props:{post}}));
}
interface Props { post:CollectionEntry<'blog'> }
const {post}=Astro.props;
const {Content}=await render(post);
const canonical='/blog/'+blogSlug(post.id)+'/';
---
<BlogArticle lang="zh" {post} {canonical}><Content /></BlogArticle>
